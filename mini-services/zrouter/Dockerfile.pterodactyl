# =============================================================================
# KRouter — Pterodactyl-compatible Docker image
# =============================================================================
# This image is pre-built with Bun so Pterodactyl servers start instantly
# without re-downloading Bun on every install/reinstall.
#
# USAGE:
#   1. Build and push this image to a registry your Pterodactyl wings node can
#      pull from:
#
#        docker build -f Dockerfile.pterodactyl -t ghcr.io/YOUR_USER/krouter-ptero:latest .
#        docker push ghcr.io/YOUR_USER/krouter-ptero:latest
#
#   2. Edit egg-krouter.json and replace the docker_images value:
#
#        "docker_images": {
#          "KRouter": "ghcr.io/YOUR_USER/krouter-ptero:latest"
#        }
#
#   3. Re-import the egg (or edit the existing one) in the Pterodactyl panel.
#
# This Dockerfile follows Pterodactyl yolk conventions:
#   - Base = Ubuntu (matches ghcr.io/pterodactyl/yolks:* base)
#   - Runs as root (Pterodactyl wings drops privileges to the container user)
#   - Entry point is bash; the egg's "startup" field supplies the run command
# =============================================================================

FROM ubuntu:22.04

LABEL maintainer="Yz776"
LABEL org.opencontainers.image.title="KRouter Pterodactyl"
LABEL org.opencontainers.image.description="Bun runtime for the KRouter AI Gateway, pre-built for Pterodactyl panel."
LABEL org.opencontainers.image.source="https://github.com/Yz776/zrouter"

ENV DEBIAN_FRONTEND=noninteractive
ENV BUN_ENV=production
ENV NODE_ENV=production

# --- Base packages required by Pterodactyl + Bun + KRouter -------------------
#   - ca-certificates curl git unzip: clone repo + bun installer
#   - bash: Pterodactyl entry point
#   - tini: proper PID 1 signal handling (so ^C stop works from the panel)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        unzip \
        bash \
        tini \
        sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# --- Install Bun (system-wide) -----------------------------------------------
ARG BUN_VERSION=latest
RUN curl -fsSL https://bun.sh/install | bash -s -- "bun-${BUN_VERSION}" 2>/dev/null \
    || curl -fsSL https://bun.sh/install | bash
ENV BUN_INSTALL="/root/.bun"
ENV PATH="/root/.bun/bin:${PATH}"

# Sanity check
RUN bun --version

# --- Pterodactyl working directory -------------------------------------------
# Wings mounts the server's persistent volume here and runs the egg's startup
# command from this directory.
WORKDIR /home/container

# No ENTRYPOINT — Pterodactyl wings injects the startup command directly.
# tini handles signal forwarding so the panel's stop button works cleanly.
ENTRYPOINT ["/usr/bin/tini", "--"]
