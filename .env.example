# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  Rara Agent — environment template                                       ║
# ║  Copy this file to `.env` and fill in real secrets before first boot.    ║
# ║  Generate strong values with:                                             ║
# ║    KFAI_AUTH_SECRET        = openssl rand -hex 24                        ║
# ║    KROUTER_INTERNAL_TOKEN  = openssl rand -hex 32                        ║
# ║    KROUTER_ADMIN_PASSWORD   = openssl rand -base64 18 | tr -d '/+='      ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── Next.js / Rara UI ────────────────────────────────────────────────────────
# SQLite path for the Rara chat database (users, conversations, sessions,
# sandbox files metadata). Use absolute path in Docker; relative for bare-metal.
DATABASE_URL=file:./db/rara.db

# Secret used to sign Rara session tokens + admin panel JWTs.
# If you rotate this, all existing user sessions are immediately invalidated.
KFAI_AUTH_SECRET=generate-with-openssl-rand-hex-24

# ── Bundled zrouter gateway ────────────────────────────────────────────────
# The embedded zrouter is bound to 127.0.0.1:3001 (localhost-only).
# This token is the shared secret that lets the Next.js server authenticate
# against zrouter. Without it, ALL /v1/* and /admin/api/* calls return 401/403.
# Never expose this token to the browser.
KROUTER_BASE=http://127.0.0.1:3001
KROUTER_INTERNAL_TOKEN=generate-with-openssl-rand-hex-32

# zrouter dashboard login (the bundled gateway's own admin user).
# Reachable ONLY from the host (e.g. SSH tunnel: `ssh -L 3001:127.0.0.1:3001 host`).
KROUTER_ADMIN_USERNAME=admin
KROUTER_ADMIN_PASSWORD=generate-with-openssl-rand-base64-18

# MCP endpoint (used by the Rara agent's tool dispatcher — points at zrouter).
# Same KROUTER_INTERNAL_TOKEN is sent as Bearer.
MCP_ENDPOINT=http://127.0.0.1:3001/mcp

# Vision pipeline upstream (the bundled zrouter).
RARA_BASE_URL=http://127.0.0.1:3000

# ── Optional: Cloudflare Tunnel for public exposure (production) ──────────────
# If you want to expose Rara publicly without opening a port, set these and
# the tunnel service in mini-services/zrouter/src/services/cloudflare-tunnel.ts
# will pick them up. Otherwise leave them commented.
# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARE_TUNNEL_HOSTNAME=rara.your-domain.com
